@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Python COMPONENTS Interpreter)
if(NOT TARGET tvm_ffi::shared)
  if(NOT tvm_ffi_DIR)
    execute_process(COMMAND "${Python_EXECUTABLE}" -m tvm_ffi.config --cmakedir
      OUTPUT_VARIABLE tvm_ffi_DIR OUTPUT_STRIP_TRAILING_WHITESPACE
      COMMAND_ERROR_IS_FATAL ANY)
  endif()
  find_dependency(tvm_ffi CONFIG)
endif()
if("@USE_THREADS@")
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tvm_tirxTargets.cmake")
set(TVM_TIRX_VERSION "@TVM_TIRX_VERSION@")
set(TVM_TIRX_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(TVM_TIRX_USE_CUDA "@USE_CUDA@")
set(TVM_TIRX_USE_ROCM "@USE_ROCM@")
set(TVM_TIRX_BUILD_FOR_ANDROID "@BUILD_FOR_ANDROID@")
