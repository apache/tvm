@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if("@TVM_TIRX_USE_THREADS@" OR "@TVM_FFI_USE_THREADS@")
  find_dependency(Threads)
endif()
if("@TVM_TIRX_FFI_HAS_BACKTRACE@" AND NOT TARGET tvm_ffi::backtrace)
  add_library(tvm_ffi::backtrace STATIC IMPORTED)
  set_target_properties(tvm_ffi::backtrace PROPERTIES
    IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libbacktrace.a")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tvm_tirxFFITargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tvm_tirxTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/utils/tvm_ffi/Library.cmake")
set(TVM_TIRX_VERSION "@TVM_TIRX_VERSION@")
set(TVM_TIRX_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(TVM_TIRX_USE_CUDA "@TVM_TIRX_USE_CUDA@")
set(TVM_TIRX_USE_ROCM "@TVM_TIRX_USE_ROCM@")
set(TVM_TIRX_BUILD_FOR_ANDROID "@BUILD_FOR_ANDROID@")
